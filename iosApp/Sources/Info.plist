<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Scene lifecycle declared explicitly, the way the UIKit application
	     template does it, instead of relying on a generated manifest with an
	     empty scene configuration list. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- A launch storyboard is required: without one iOS runs the app in
	     Compatibility Mode, letterboxed and scaled up like an iPhone 4, which
	     is what made the app look like it was drawn for a tiny screen. -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<!-- Compose Multiplatform aborts at launch with an IllegalStateException
	     from PlistSanityCheck unless this key is present and true. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- The interface is portrait; the player asks the window for landscape while
	     it is open, through supportedInterfaceOrientationsFor. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- The system player can keep playing in Picture in Picture, which iOS
	     only allows to an app that declares audio playback in the background. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- The optional app lock asks for the device passcode or Face ID. -->
	<key>NSFaceIDUsageDescription</key>
	<string>يُستخدم Face ID لفتح CINEMAX عندما يُفعّل قفل التطبيق.</string>
	<!-- A frame grabbed from the player is written to the photo library. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>لحفظ لقطة من الفيلم أو الحلقة في تطبيق الصور عندما تطلب ذلك من المشغّل.</string>
	<!-- Many of the free sources answer over plain http, and both the system
	     player and the poster loader refuse a clear channel without this. It is
	     not a convenience: a large share of the Arabic links are http only, and
	     without the exception they fail before the first frame. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
